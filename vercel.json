{
  "version": 2,
  "name": "zkp-did-auth-frontend",
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "REACT_APP_BACKEND_URL": "@zkp-backend-url",
    "REACT_APP_CONTRACT_ADDRESS": "@zkp-contract-address"
  }
}
